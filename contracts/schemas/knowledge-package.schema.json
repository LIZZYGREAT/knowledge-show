{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/knowledge-video/KnowledgePackage.schema.json",
  "title": "KnowledgePackage",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "brief_revision": {
      "type": "integer",
      "minimum": 1
    },
    "directions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "core_question": {
            "type": "string",
            "minLength": 1
          },
          "hook": {
            "type": "string",
            "minLength": 1
          },
          "learning_goal": {
            "type": "string",
            "minLength": 1
          },
          "knowledge_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "minItems": 1
          },
          "visual_potential": {
            "type": "object",
            "properties": {
              "level": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "level",
              "reason"
            ],
            "additionalProperties": false
          },
          "recommendation_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "core_question",
          "hook",
          "learning_goal",
          "knowledge_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "recommended_direction_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "knowledge_units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "type": {
            "enum": [
              "fact",
              "concept",
              "principle",
              "phenomenon",
              "example",
              "analogy",
              "derivation",
              "application"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "enum": [
              "core",
              "supporting",
              "optional"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "uniqueItems": true
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "minItems": 1
          },
          "visual_potential": {
            "type": "object",
            "properties": {
              "level": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "level",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "content",
          "explanation",
          "importance",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "external_source",
              "mathematical_derivation",
              "user_material"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "title"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "constraints": {
      "type": "object",
      "properties": {
        "required_knowledge_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "must_not_misrepresent": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "required_knowledge_refs",
        "must_not_misrepresent"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "artifact_id",
    "revision",
    "brief_revision",
    "directions",
    "recommended_direction_id",
    "knowledge_units",
    "evidence",
    "constraints"
  ],
  "additionalProperties": false
}
