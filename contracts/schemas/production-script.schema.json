{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductionScript",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "brief_revision": {
      "type": "integer",
      "minimum": 1
    },
    "knowledge_package_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "artifact_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "direction_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "total_duration_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 900000
    },
    "core_message": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "hook",
              "setup",
              "explain",
              "twist",
              "payoff",
              "other"
            ]
          },
          "visual_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "offset_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "anchor": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "knowledge_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "offset_ms",
                "description"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "knowledge_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "uniqueItems": true
          },
          "timed_text": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "offset_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "subtitle",
                    "title",
                    "annotation"
                  ]
                }
              },
              "required": [
                "id",
                "offset_ms",
                "duration_ms",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "audio_intent": {
            "type": "string",
            "minLength": 1
          },
          "semantic_constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "scene_id",
          "start_ms",
          "duration_ms",
          "objective",
          "events",
          "knowledge_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "project_id",
    "artifact_id",
    "revision",
    "brief_revision",
    "knowledge_package_ref",
    "direction_id",
    "total_duration_ms",
    "core_message",
    "scenes"
  ],
  "additionalProperties": false
}
