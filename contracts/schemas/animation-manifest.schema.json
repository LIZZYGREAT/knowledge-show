{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnimationManifest",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "brief_revision": {
      "type": "integer",
      "minimum": 1
    },
    "production_script_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "artifact_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "total_duration_ms": {
      "type": "integer",
      "minimum": 1000
    },
    "preview_ref": {
      "type": "string",
      "minLength": 1
    },
    "selectable_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "source_ref": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "timed_text",
                  "script_event"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clip_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "scene_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1
          },
          "resource_ref": {
            "type": "string",
            "minLength": 1
          },
          "script_event_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "uniqueItems": true
          },
          "internal_events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "offset_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "script_event_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "offset_ms",
                "description"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "clip_id",
          "scene_id",
          "start_ms",
          "duration_ms",
          "resource_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "project_id",
    "artifact_id",
    "revision",
    "brief_revision",
    "production_script_ref",
    "total_duration_ms",
    "clips"
  ],
  "additionalProperties": false
}
